  "validation": {
    "tests": "scripts/tests/host-package-installer.test.cjs",
    "method": "Mock native transport/storage and data-only immutable artifact checks; no actual console API request, package installation or downloaded payload execution."
  },
  "limitations": [
    "Matching native ezRemote Client must be installed, running and serving this helper at its exact path.",
    "PS5 requires its native Direct Package Installer prerequisites.",
    "No firmware compatibility, available-space or successful-installation fact is inferred from a file extension, listing or HTTP200.",
    "Native service has no atomic installer transaction exposed to this helper; localStorage guard reduces duplicate dispatch but does not control another native app or simultaneous browser process.",
    "Native completion OS notifications belong to ezRemote Server itself; no generic notification API is invented. See docs/host-package-notification-review-20261103.json."
  ]
