  "nativeContracts": {
    "list": {
      "method": "POST",
      "path": "/__local__/list",
      "json": {
        "path": "{savedFileParent}",
        "onlyFolders": false
      },
      "result": "result array; require exact regular-file entry with integral byte size and no matching .tmp entry."
    },
    "install": {
      "method": "POST",
      "path": "/__local__/install",
      "json": {
        "items": [
          "{singleVerifiedAbsolutePkgPath}"
        ]
      },
      "result": "result.success must be exactly true; success is reported as native service success, never proved installed."
    },
    "ps4": "Native InstallLocalPkg may uninstall an existing application on BGFT registration collision before retrying. The user-facing warning and explicit checkbox precede each request. The native handler waits on BGFT transfer progress.",
    "ps5": "Native local install calls the existing Direct Package Installer and returns after acceptance when remove_after_install=false. Compatible DPI must already be running; the helper does not load it or probe its TCP service."
  },
  "safeguards": [
    "No requests on opening, query preselection or view rendering. Public/wrong-origin preview is read-only.",
    "Writes use only the exact matching default client origin: PS4 8080 or PS5 9090; no Origin spoofing or cross-origin proxy.",
    "Only absolute bounded /data/.../*.pkg or /mnt/usb[0-9]/.../*.pkg paths; refuse other roots, ext mounts, URL/query/fragment, encoded tricks, traversal, archives and payloads.",
    "List metadata verifies an exact saved entry, expected size when supplied and absence of a matching .tmp; re-read immediately before install. This is not full-file SHA-256/signature/title/compatibility verification.",
    "One pending operation per helper; a durable request guard is saved and re-read before dispatch. Existing guards block further installs across reloads.",
    "A native success acknowledgement also retains the request guard; check the console result, then explicitly clear it. Clearing sends nothing and cancels nothing.",
    "Lost/invalid/negative responses after dispatch are uncertain; retain the guard and never automatically retry.",
    "Selected-file metadata is internally copied; mutating or cloning a returned verification object cannot authorize a different path.",
    "No delete/uninstall API, raw payload launch, install-from-URL route, package upload or silent install-after-download is implemented.",
    "Native app behavior can replace installed titles. Metadata checks are not atomic file-content locks; use one helper window and keep other native installers/writers idle."
  ],
  "languages": {
    "status": "Self-contained inline language adapter and exact authored-key subset. All 20 non-English dictionary keys are required before generation; filenames, path/size displays and input values are excluded from DOM translation.",
