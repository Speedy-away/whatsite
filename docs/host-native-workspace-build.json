      "json": {
        "item": "{absoluteFile}"
      },
      "result": "result is a string; read only after size check."
    },
    {
      "method": "POST",
      "path": "/__local__/edit",
      "json": {
        "item": "{uniqueConfigStagingFile}",
        "content": "{fullPreservedText}"
      },
      "result": "result.success, followed by raw byte hash verification."
    },
    {
      "method": "POST",
      "path": "/__local__/upload",
      "multipartOrdered": [
        "destination",
        "_chunkSize",
        "_chunkNumber=0",
        "_totalSize",
        "_currentChunkSize",
        "file"
      ],
      "result": "Single complete BIN/ELF or backup upload; no automatic resume/retry; verify raw saved bytes."
    },
    {
      "method": "POST",
      "path": "/__local__/createFolder",
      "json": {
        "newPath": "{managedAbsolutePath}"
      },
      "result": "Native acknowledgement followed by parent-list postcondition."
    },
    {
      "method": "POST",
      "path": "/__local__/rename",
      "json": {
        "item": "{source}",
        "newItemPath": "{destination}"
      },
      "result": "Never overwrite a payload destination; config staging replacement follows verified backup, hash precondition and final readback."
    }
  ],
