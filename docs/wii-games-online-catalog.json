    {
      "id": "riivolution",
      "title": "Riivolution",
      "kind": "app",
      "version": "v1.06",
      "group": "Mod loaders",
      "description": "Apply custom levels, textures, music and other patches to retail Wii discs at launch.",
      "requirements": "Homebrew Channel on Wii or vWii, your retail disc, and matching mod XML/data. The project documents an updated IOS37 on original Wii; use model-specific instructions for vWii rather than a stock-Wii IOS installer.",
      "compatibility": "Standard v1.06 is for Wii and vWii. The Wii Mini build is listed separately.",
      "setup": "Copy apps/riivolution to the storage root. Mod XML files normally go in /riivolution; keep mod data at the paths specified inside that XML. Start Riivolution, select the intended patch and launch the disc. Installing a System Menu shortcut is optional.",
